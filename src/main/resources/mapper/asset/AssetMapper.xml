<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.opsflow.asset.mapper.AssetMapper">

    <resultMap id="BaseResultMap" type="org.example.opsflow.asset.entity.Asset">
            <id property="id" column="id" />
            <result property="assetNo" column="asset_no" />
            <result property="name" column="name" />
            <result property="category" column="category" />
            <result property="model" column="model" />
            <result property="assignedUserId" column="assigned_user_id" />
            <result property="status" column="status" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,asset_no,name,category,model,assigned_user_id,
        status,created_at,updated_at
    </sql>

    <select id="findById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from sys_asset
        where  id = #{id}
    </select>
    <select id="findAll" resultType="org.example.opsflow.asset.entity.Asset">
        select
        <include refid="Base_Column_List" />
        from sys_asset
        ORDER BY id DESC
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from sys_asset
        where  id = #{id} 
    </delete>
    <insert id="insert" keyColumn="id" keyProperty="id" parameterType="org.example.opsflow.asset.entity.Asset" useGeneratedKeys="true">
        insert into sys_asset
        (asset_no,name,category,model,status)
        values (#{assetNo},#{name},#{category},#{model},#{status})
    </insert>
    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="org.example.opsflow.asset.entity.Asset" useGeneratedKeys="true">
        insert into sys_asset
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="assetNo != null">asset_no,</if>
                <if test="name != null">name,</if>
                <if test="category != null">category,</if>
                <if test="model != null">model,</if>
                <if test="assignedUserId != null">assigned_user_id,</if>
                <if test="status != null">status,</if>
                <if test="createdAt != null">created_at,</if>
                <if test="updatedAt != null">updated_at,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                <if test="assetNo != null">#{assetNo},</if>
                <if test="name != null">#{name},</if>
                <if test="category != null">#{category},</if>
                <if test="model != null">#{model},</if>
                <if test="assignedUserId != null">#{assignedUserId},</if>
                <if test="status != null">#{status},</if>
                <if test="createdAt != null">#{createdAt},</if>
                <if test="updatedAt != null">#{updatedAt},</if>
        </trim>
    </insert>
    <update id="updateByPrimaryKeySelective" parameterType="org.example.opsflow.asset.entity.Asset">
        update sys_asset
        <set>
                <if test="assetNo != null">
                    asset_no = #{assetNo},
                </if>
                <if test="name != null">
                    name = #{name},
                </if>
                <if test="category != null">
                    category = #{category},
                </if>
                <if test="model != null">
                    model = #{model},
                </if>
                <if test="assignedUserId != null">
                    assigned_user_id = #{assignedUserId},
                </if>
                <if test="status != null">
                    status = #{status},
                </if>
                <if test="createdAt != null">
                    created_at = #{createdAt},
                </if>
                <if test="updatedAt != null">
                    updated_at = #{updatedAt},
                </if>
        </set>
        where   id = #{id} 
    </update>
    <update id="updateAsset" parameterType="org.example.opsflow.asset.entity.Asset">
        update sys_asset
        set 
            asset_no =  #{assetNo},
            name =  #{name},
            category =  #{category},
            model =  #{model}
        where  id = #{id}
    </update>
    <update id="updateAssetStatus">
        UPDATE sys_asset SET status = #{status} WHERE id = #{id}
    </update>
    <update id="updateAssetAssignee">
        UPDATE sys_asset SET assigned_user_id = #{status} WHERE id = #{id}
    </update>
</mapper>
